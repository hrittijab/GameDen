
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasPlayerProfile() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function canReadRoom() {
      return request.auth != null

        && (
          // Existing members can recover their
          // room without another profile lookup.
          (
            resource != null

            && request.auth.uid
              in resource.data.players.keys()
          )

          ||

          // Onboarded players may check unused
          // codes and discover waiting rooms.
          (
            (
              resource == null ||
              resource.data.status == 'lobby'
            )

            && hasPlayerProfile()
          )
        );
    }

    function validRoomIdentity() {
      let profile = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;

      let data = request.resource.data;

      return hasPlayerProfile()

        && data.players[request.auth.uid]
          == profile.nickname

        && data.playerAvatars is map

        && data.playerAvatars[request.auth.uid]
          == profile.avatar;
    }

    function validCreatedAvatars() {
      return validRoomIdentity()

        && request.resource.data.playerAvatars
          .keys().hasOnly([request.auth.uid]);
    }

    function validJoinedAvatars() {
      return validRoomIdentity()

        && request.resource.data.playerAvatars
          .diff(
            resource.data.get('playerAvatars', {})
          )
          .affectedKeys()
          .hasOnly([request.auth.uid]);
    }


    // ======================================
    // PLAYER PROFILES
    // ======================================

    match /users/{uid} {

      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid;
      }

      function validProfile() {
        let data = request.resource.data;

        return data.keys().hasAll([
            'nickname',
            'avatar',
            'createdAt',
            'updatedAt'
          ])

          && data.keys().hasOnly([
            'nickname',
            'avatar',
            'createdAt',
            'updatedAt'
          ])

          && data.nickname is string
          && data.nickname.size() >= 1
          && data.nickname.size() <= 24

          && data.nickname.matches(
            '^\\S(.*\\S)?$'
          )

          && data.avatar in [
            '🐼', '🦊', '🐱', '🐸',
            '🐯', '🐨', '🐶', '🐰',
            '🦁', '🐵', '🐧', '🦉'
          ]

          && data.createdAt is timestamp
          && data.updatedAt == request.time;
      }

      allow get: if isOwner();

      allow list: if false;

      allow create: if isOwner()
        && validProfile()
        && request.resource.data.createdAt
          == request.time;

      allow update: if isOwner()
        && validProfile()
        && request.resource.data.createdAt
          == resource.data.createdAt;

      allow delete: if false;
    }


    match /colorClashRooms/{roomCode} {

      function signedIn() {
        return request.auth != null;
      }

      function validName(name) {
        return name is string
          && name.size() >= 1
          && name.size() <= 24;
      }

      allow get: if canReadRoom();

      allow list: if false;

      allow create: if signedIn()
        && validCreatedAvatars()

        && roomCode.matches(
          '^[A-HJ-NP-Z2-9]{8}$'
        )

        && request.resource.data.keys()
          .hasOnly([
            'hostId',
            'status',
            'players',
            'playerAvatars'
          ])

        && request.resource.data.hostId
          == request.auth.uid

        && request.resource.data.status
          == 'lobby'

        && request.resource.data.players
          .keys().hasOnly([
            request.auth.uid
          ])

        && request.resource.data.players
          .size() == 1

        && validName(
          request.resource.data.players[
            request.auth.uid
          ]
        );

      allow update: if signedIn()
        && validJoinedAvatars()

        && resource.data.status == 'lobby'

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['players', 'playerAvatars'])

        && request.resource.data.players
          .size() <= 20

        && !resource.data.players
          .keys().hasAny([
            request.auth.uid
          ])

        && request.resource.data.players
          .diff(resource.data.players)
          .addedKeys()
          .hasOnly([
            request.auth.uid
          ])

        && request.resource.data.players
          .diff(resource.data.players)
          .addedKeys().size() == 1

        && request.resource.data.players
          .diff(resource.data.players)
          .removedKeys().size() == 0

        && request.resource.data.players
          .diff(resource.data.players)
          .changedKeys().size() == 0

        && validName(
          request.resource.data.players[
            request.auth.uid
          ]
        );

      allow delete: if false;

      // ====================================
      // PRIVATE PLAYER HANDS
      // ====================================

      match /hands/{playerId} {

        allow get: if signedIn()

          && request.auth.uid == playerId

          && request.auth.uid in get(
            /databases/$(database)/documents/colorClashRooms/$(roomCode)
          ).data.players.keys();

        allow list, create, update, delete:
          if false;
      }

      // ====================================
      // CONNECTION STATUS
      // ====================================

      match /presence/{playerId} {

        allow get, list: if signedIn()

          && request.auth.uid in get(
            /databases/$(database)/documents/colorClashRooms/$(roomCode)
          ).data.players.keys();

        // Only the trusted backend can
        // create or modify heartbeats.

        allow create, update, delete:
          if false;
      }
    }

    // ======================================
    // PRIVATE GAME ENGINE STATE
    // ======================================

    match /colorClashSecrets/{roomCode} {
      allow read, write: if false;
    }
    // ======================================
    // DOODLE CLASH
    // ======================================

    match /doodleClashRooms/{roomCode} {

      function signedIn() {
        return request.auth != null;
      }

      function validName(name) {
        return name is string
          && name.size() >= 1
          && name.size() <= 24;
      }

      function isMember() {
        return signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/doodleClashRooms/$(roomCode)
          ).data.players.keys();
      }

      allow get: if canReadRoom();

      allow list: if false;

      allow create: if signedIn()
        && validCreatedAvatars()

        && roomCode.matches('^[A-HJ-NP-Z2-9]{8}$')

        && request.resource.data.keys()
          .hasOnly(['hostId', 'status', 'players', 'playerAvatars'])

        && request.resource.data.hostId
          == request.auth.uid

        && request.resource.data.status == 'lobby'

        && request.resource.data.players
          .keys().hasOnly([request.auth.uid])

        && request.resource.data.players.size() == 1

        && validName(
          request.resource.data.players[request.auth.uid]
        );

      allow update: if signedIn()
        && validJoinedAvatars()

        && resource.data.status == 'lobby'

        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['players', 'playerAvatars'])

        && request.resource.data.players.size() <= 12

        && !resource.data.players
          .keys().hasAny([request.auth.uid])

        && request.resource.data.players
          .diff(resource.data.players)
          .addedKeys().hasOnly([request.auth.uid])

        && request.resource.data.players
          .diff(resource.data.players)
          .addedKeys().size() == 1

        && request.resource.data.players
          .diff(resource.data.players)
          .removedKeys().size() == 0

        && request.resource.data.players
          .diff(resource.data.players)
          .changedKeys().size() == 0

        && validName(
          request.resource.data.players[request.auth.uid]
        );

      allow delete: if false;

      match /activity/{activityId} {

        allow get: if isMember()
          && activityId == 'current';

        allow list, create, update, delete: if false;
      }

      match /preview/{previewId} {

        allow get: if isMember()
          && previewId == 'current';

        allow list, create, update, delete: if false;
      }

      match /drawing/{drawingId} {

        allow get: if isMember()
          && drawingId == 'current';

        allow list, create, update, delete: if false;
      }

      match /presence/{playerId} {

        allow get, list: if isMember();

        allow create, update, delete: if false;
      }
    }

    match /wordClashRooms/{roomCode} {

      function signedIn() {
        return request.auth != null;
      }

      function validName(name) {
        return name is string
          && name.size() >= 1
          && name.size() <= 24;
      }

      function isMember() {
        return signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/wordClashRooms/$(roomCode)
          ).data.players.keys();
      }

      allow get: if canReadRoom();
      allow list: if false;

      allow create: if signedIn()
        && validCreatedAvatars()

        && roomCode.matches('^[A-HJ-NP-Z2-9]{8}$')

        && request.resource.data.keys()
          .hasOnly(['hostId', 'status', 'players', 'playerAvatars'])

        && request.resource.data.hostId
          == request.auth.uid

        && request.resource.data.status == 'lobby'

        && request.resource.data.players
          .keys().hasOnly([request.auth.uid])

        && request.resource.data.players.size() == 1

        && validName(
          request.resource.data.players[request.auth.uid]
        );

      allow update: if signedIn()
        && validJoinedAvatars()

        && resource.data.status == 'lobby'

        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['players', 'playerAvatars'])

        && request.resource.data.players.size() <= 12

        && !resource.data.players
          .keys().hasAny([request.auth.uid])

        && request.resource.data.players
          .diff(resource.data.players)
          .addedKeys().hasOnly([request.auth.uid])

        && request.resource.data.players
          .diff(resource.data.players)
          .addedKeys().size() == 1

        && request.resource.data.players
          .diff(resource.data.players)
          .removedKeys().size() == 0

        && request.resource.data.players
          .diff(resource.data.players)
          .changedKeys().size() == 0

        && validName(
          request.resource.data.players[request.auth.uid]
        );

      allow delete: if false;

      match /presence/{playerId} {

        allow get, list: if isMember();

        allow create, update, delete: if false;
      }
    }

    match /wordClashSecrets/{roomCode} {
      allow read, write: if false;
    }

    match /doodleClashSecrets/{roomCode} {
      allow read, write: if false;
    }

  }
}









